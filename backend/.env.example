# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=qikbanco
DB_PASSWORD=qikbanco
DB_NAME=qikbanco_ledger

# Redis (cache de resúmenes de balance)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1h

# Correo de confirmación (opcional). Si dejas esto vacío, el backend
# funciona igual: solo loguea el correo en vez de enviarlo.
#
# Opción A — Gmail: genera una "contraseña de aplicación" en
#   https://myaccount.google.com/apppasswords (necesitas 2FA activado)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tu-correo@gmail.com
#   SMTP_PASS=la-contraseña-de-16-caracteres-que-te-dio-google
#
# Opción B — Resend (resend.com, 100 correos/día gratis):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=tu-api-key-de-resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QikBanco <no-reply@qikbanco.local>
